# ==============================================================================
# MECHSTUDY OS — Root Repository Exclusion Policy
# Policy: Software only. Zero personal study notes, zero PDFs, zero databases.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Personal Study Library & Educational Materials (Strict Exclusion)
# ------------------------------------------------------------------------------
*.pdf
*.epub
*.doc
*.docx
*.ppt
*.pptx
*.djvu
*.mobi

# Specific study folders at root
20.Engineering Mathematics(D)/
21.General Ability(D)/
22.Mechanical-Short-Notes(D)/
Assigment/
Book/
Gate paper and answer key/
.freebuff/

# ------------------------------------------------------------------------------
# 2. Local Databases & User Caches (Personal data in %APPDATA%)
# ------------------------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.db.bak
MECHSTUDY-OS/*.db
MECHSTUDY-OS/*.db-wal
MECHSTUDY-OS/*.db-shm
MECHSTUDY-OS/backups/
MECHSTUDY-OS/exports/
MECHSTUDY-OS/scratch/

# ------------------------------------------------------------------------------
# 3. AI Models & Large Weights
# ------------------------------------------------------------------------------
*.gguf
*.bin
*.pt
*.safetensors
*.onnx

# ------------------------------------------------------------------------------
# 4. Large Archives & Installers (Binaries belong in GitHub Releases)
# ------------------------------------------------------------------------------
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.iso
*.exe
*.msi

# Whitelist source installation helper scripts
!install.ps1
!uninstall.ps1
!MECHSTUDY-OS/install.ps1
!MECHSTUDY-OS/uninstall.ps1

# ------------------------------------------------------------------------------
# 5. Build Outputs, Packaging & Dependencies
# ------------------------------------------------------------------------------
MECHSTUDY-OS/node_modules/
MECHSTUDY-OS/out/
MECHSTUDY-OS/release/
MECHSTUDY-OS/dist/
MECHSTUDY-OS/.test-build/
MECHSTUDY-OS/.vite/
MECHSTUDY-OS/coverage/
MECHSTUDY-OS/.eslintcache

# pdf.js runtime assets copied by tools/copy-pdfjs-assets.mjs
MECHSTUDY-OS/src/renderer/public/pdfjs/

# Derived index snapshot
MECHSTUDY-OS/data/index/

# ------------------------------------------------------------------------------
# 6. Local Logs
# ------------------------------------------------------------------------------
*.log
MECHSTUDY-OS/*.log
MECHSTUDY-OS/dev.log
MECHSTUDY-OS/preview.log

# ------------------------------------------------------------------------------
# 7. OS & IDE Metadata
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
__pycache__/
*.pyc
