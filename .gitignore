# ---------------------------------------------------------------------------
# MECHSTUDY OS — repository ignore rules
# ---------------------------------------------------------------------------
# The repository root also holds the user's study library (66 PDFs, ~0.95 GB).
# Those files are read in place by the app and must never be committed, copied
# or regenerated by tooling.
*.pdf
!MECHSTUDY-OS/data/gate/*.pdf

# Large media that is never source
*.zip
*.7z
*.iso

# ---------------------------------------------------------------------------
# Application (MECHSTUDY-OS/)
# ---------------------------------------------------------------------------
MECHSTUDY-OS/node_modules/
MECHSTUDY-OS/out/
MECHSTUDY-OS/release/
MECHSTUDY-OS/dist/

# pdf.js runtime data is copied from node_modules by
# tools/copy-pdfjs-assets.mjs on predev/prebuild — never committed, so it can
# never drift from the installed pdfjs-dist version.
MECHSTUDY-OS/src/renderer/public/pdfjs/

# Local logs and reports produced while running the app
MECHSTUDY-OS/dev.log
MECHSTUDY-OS/preview.log
MECHSTUDY-OS/*.log

# Local databases, backups and exports (the real data lives in %APPDATA%)
MECHSTUDY-OS/*.db
MECHSTUDY-OS/*.db-wal
MECHSTUDY-OS/*.db-shm
MECHSTUDY-OS/backups/
MECHSTUDY-OS/exports/

# Derived index snapshot: regenerate with `npm run tools:build-index`.
# It embeds absolute paths and content hashes that change on every import.
MECHSTUDY-OS/data/index/

# Tooling caches
MECHSTUDY-OS/.vite/
MECHSTUDY-OS/coverage/
MECHSTUDY-OS/.eslintcache

# Compiled integration tests (tsc output)
MECHSTUDY-OS/.test-build/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# Python bytecode (tools/ and the legacy extract_syllabus.py)
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
