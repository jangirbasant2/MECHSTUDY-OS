{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2023"],
    "strict": true,
    "noUnusedLocals": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "rootDir": "../..",
    "outDir": "../../.test-build",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["../../src/main/**/*.ts", "../../src/shared/**/*.ts", "./**/*.ts"]
}
